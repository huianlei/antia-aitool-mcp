#!/bin/bash
# Auto-switch to the correct Go version when entering this directory
# This file should be sourced by your shell (add to .bashrc or .zshrc)

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GO_VERSION_FILE="$PROJECT_DIR/.go-version"

if [ -f "$GO_VERSION_FILE" ]; then
    REQUIRED_GO_VERSION=$(cat "$GO_VERSION_FILE")
    CURRENT_GO_VERSION=$(go version | awk '{print $3}' | sed 's/go//')

    if [ "$CURRENT_GO_VERSION" != "$REQUIRED_GO_VERSION" ]; then
        echo "Switching to Go $REQUIRED_GO_VERSION for this project..."
        if command -v gvm &> /dev/null; then
            gvm use "$REQUIRED_GO_VERSION" > /dev/null 2>&1
            if [ $? -eq 0 ]; then
                echo "✓ Go version switched to $REQUIRED_GO_VERSION"
            else
                echo "⚠ Failed to switch Go version. Please run: gvm use $REQUIRED_GO_VERSION"
            fi
        else
            echo "⚠ gvm not found. Please install gvm or manually switch to Go $REQUIRED_GO_VERSION"
        fi
    fi
fi
