{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Server",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/server",
			"cwd": "${workspaceFolder}",
			"args": [
				"--config",
				"${workspaceFolder}/configs/config.yaml"
			],
			"env": {
				"GOROOT": "/Users/admin/.gvm/gos/go1.25.12",
				"GOPATH": "/Users/admin/.gvm/pkgsets/go1.25.12/global",
				"PATH": "/Users/admin/.gvm/gos/go1.25.12/bin:/Users/admin/.gvm/pkgsets/go1.25.12/global/bin",
				"JENKINS_PASSWORD": "hal@123"
			},
			"console": "integratedTerminal",
			"showLog": true
		},
		{
			"name": "Launch Server (Mock Plugin Only)",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/server",
			"args": [
				"--config",
				"${workspaceFolder}/configs/config.yaml"
			],
			"console": "integratedTerminal",
			"showLog": false
		},
		{
			"name": "Test Current File",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${file}",
			"showLog": true
		},
		{
			"name": "Test Current Package",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${fileDirname}",
			"showLog": true
		},
		{
			"name": "Test All",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}",
			"args": [
				"-v"
			],
			"showLog": true
		},
		{
			"name": "Test with Coverage",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}",
			"args": [
				"-v",
				"-coverprofile=coverage.out"
			],
			"showLog": true
		},
		{
			"name": "Attach to Process",
			"type": "go",
			"request": "attach",
			"mode": "local",
			"processId": "${command:pickProcess}",
			"showLog": true
		}
	]
}
